#!/usr/bin/env sh
# The Rinth build CLI. Builds the tool with Gradle (fast when nothing changed), then runs it.
# `./rinth help` lists the commands.
set -eu

root=$(cd "$(dirname "$0")" && pwd)

case "${1:-}" in
  survey) module=survey ;;
  copycheck) module=copycheck ;;
  *) module=build ;;
esac

"$root/gradlew" --quiet --console=plain -p "$root" ":tools:$module:installDist"

# The tool finds the repo from the caller's directory, so it works from any subfolder.
export RINTH_BUILD_OPTS="${RINTH_BUILD_OPTS:-} -Drinth.cwd=$(pwd)"
export RINTH_SURVEY_OPTS="${RINTH_SURVEY_OPTS:-} -Drinth.cwd=$(pwd)"
export RINTH_COPYCHECK_OPTS="${RINTH_COPYCHECK_OPTS:-} -Drinth.cwd=$(pwd)"

# The survey and copycheck are their own programs; the command name isn't an argument to them.
if [ "$module" != build ]; then
  shift
fi
exec "$root/tools/$module/build/install/rinth-$module/bin/rinth-$module" "$@"
