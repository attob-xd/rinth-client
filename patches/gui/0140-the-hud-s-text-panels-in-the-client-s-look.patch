+            // Rinth start: the tab list on rounded glass (HudLook)
+            if (!rinth.client.look.HudLook.tabBox(graphics, screenWidth / 2 - maxLineWidth / 2 - 1, yyo - 1, screenWidth / 2 + maxLineWidth / 2 + 1, yyo + headerLines.size() * 9, true, false))
+            // Rinth end
             graphics.fill(
@@ -194,2 +197,5 @@
 
+        // Rinth start: the tab list on rounded glass (HudLook)
+        if (!rinth.client.look.HudLook.tabBox(graphics, screenWidth / 2 - maxLineWidth / 2 - 1, yyo - 1, screenWidth / 2 + maxLineWidth / 2 + 1, yyo + rows * 9, headerLines == null, footerLines == null))
+        // Rinth end
         graphics.fill(screenWidth / 2 - maxLineWidth / 2 - 1, yyo - 1, screenWidth / 2 + maxLineWidth / 2 + 1, yyo + rows * 9, Integer.MIN_VALUE);
@@ -202,2 +208,5 @@
             int yo = yyo + row * 9;
+            // Rinth start: the tab list on rounded glass (HudLook)
+            if (!rinth.client.look.HudLook.tabRow(graphics, xo, yo, xo + slotWidth, yo + 8))
+            // Rinth end
             graphics.fill(xo, yo, xo + slotWidth, yo + 8, background);
@@ -229,2 +238,5 @@
             yyo += rows * 9 + 1;
+            // Rinth start: the tab list on rounded glass (HudLook)
+            if (!rinth.client.look.HudLook.tabBox(graphics, screenWidth / 2 - maxLineWidth / 2 - 1, yyo - 1, screenWidth / 2 + maxLineWidth / 2 + 1, yyo + footerLines.size() * 9, false, true))
+            // Rinth end
             graphics.fill(
diff --git a/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java b/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java
index b5cfe4956f0ac38faa9e1bf6c1cae9ed1798729a..015c3017d0a7d85b1a72f2d04e6f95e112a394c0 100644
--- a/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java
+++ b/src/main/java/net/minecraft/client/gui/screens/ChatScreen.java
@@ -277,2 +277,5 @@
     public void extractRenderState(final GuiGraphicsExtractor graphics, final int mouseX, final int mouseY, final float a) {
+        // Rinth start: the chat field as a rounded well (HudLook)
+        if (!rinth.client.look.HudLook.chatField(graphics, 2, this.height - 14, this.width - 2, this.height - 2))
+        // Rinth end
         graphics.fill(2, this.height - 14, this.width - 2, this.height - 2, this.minecraft.options.getBackgroundColor(Integer.MIN_VALUE));
