Subject: [PATCH] gui: The HUD's text panels in the client's look

Signed-off-by: rinth-client <335801235+rinth-client@users.noreply.github.com>

diff --git a/src/main/java/net/minecraft/client/gui/Hud.java b/src/main/java/net/minecraft/client/gui/Hud.java
index deccde690ddda03d4d2a1ecf23d0686146e35951..7c842fbd6aa3cfd33c4be9c70eaef4345ac50744 100644
--- a/src/main/java/net/minecraft/client/gui/Hud.java
+++ b/src/main/java/net/minecraft/client/gui/Hud.java
@@ -726,4 +726,10 @@
         int headerY = bottom - entriesCount * 9;
+        // Rinth start: the sidebar on one glass card (HudLook)
+        if (!rinth.client.look.HudLook.scoreboard(graphics, left - 2, headerY - 9 - 1, right, bottom, headerY - 1)) {
+        // Rinth end
         graphics.fill(left - 2, headerY - 9 - 1, right, headerY - 1, headerBackgroundColor);
         graphics.fill(left - 2, headerY - 1, right, bottom, backgroundColor);
+        // Rinth start
+        }
+        // Rinth end
         graphics.text(this.getFont(), objectiveDisplayName, left + width / 2 - objectiveDisplayNameWidth / 2, headerY - 9, -1, false);
diff --git a/src/main/java/net/minecraft/client/gui/components/ChatComponent.java b/src/main/java/net/minecraft/client/gui/components/ChatComponent.java
index 1e1e3229fb3968d0c074f2c27c18e0fabf67abf7..bca3960296de57069d08e6ca23d6859be5288aaa 100644
--- a/src/main/java/net/minecraft/client/gui/components/ChatComponent.java
+++ b/src/main/java/net/minecraft/client/gui/components/ChatComponent.java
@@ -166,3 +166,5 @@
                 int entryTop = entryBottom - entryHeight;
-                graphics.fill(-4, entryTop, maxWidth + 4 + 4, entryBottom, ARGB.black(alphax * backgroundOpacity));
+                // Rinth start: chat's lines on the look's cold tint (HudLook)
+                graphics.fill(-4, entryTop, maxWidth + 4 + 4, entryBottom, rinth.client.look.HudLook.chatLine(ARGB.black(alphax * backgroundOpacity)));
+                // Rinth end
             });
