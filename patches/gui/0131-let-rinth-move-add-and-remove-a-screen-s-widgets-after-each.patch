From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rinth-client <335801235+rinth-client@users.noreply.github.com>
Date: Sat, 10 Oct 2026 10:08:46 -0400
Subject: [PATCH] gui: Let Rinth move, add and remove a screen's widgets after
 each layout


diff --git a/src/main/java/net/minecraft/client/gui/screens/Screen.java b/src/main/java/net/minecraft/client/gui/screens/Screen.java
index bf95d2376e54d4493349ef22d9ff72c2fee3326d..4f623f3ee6deb9ffa5ad4351d12354fb5f1a6431 100644
--- a/src/main/java/net/minecraft/client/gui/screens/Screen.java
+++ b/src/main/java/net/minecraft/client/gui/screens/Screen.java
@@ -67,2 +67,9 @@
     private final List<Renderable> renderables = Lists.newArrayList();
+    // Rinth start: Rinth's edits to this screen, made again after each layout (ScreenEdits)
+    private final List<GuiEventListener> rinthAdded = Lists.newArrayList();
+
+    private void rinthEdit() {
+        rinth.client.ui.ScreenEdits.laidOut(this, this.rinthAdded, this::addRenderableWidget, this::removeWidget);
+    }
+    // Rinth end
     protected final Font font;
@@ -339,2 +346,5 @@
         this.initialized = true;
+        // Rinth start: Rinth's edits to this screen, made again after each layout (ScreenEdits)
+        this.rinthEdit();
+        // Rinth end
         this.triggerImmediateNarration(false);
@@ -352,2 +362,5 @@
         this.setInitialFocus();
+        // Rinth start: Rinth's edits to this screen, made again after each layout (ScreenEdits)
+        this.rinthEdit();
+        // Rinth end
     }
@@ -451,2 +464,5 @@
         this.repositionElements();
+        // Rinth start: Rinth's edits to this screen, made again after each layout (ScreenEdits)
+        this.rinthEdit();
+        // Rinth end
     }
