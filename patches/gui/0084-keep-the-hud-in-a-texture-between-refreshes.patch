From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rinth-client <335801235+rinth-client@users.noreply.github.com>
Date: Fri, 2 Oct 2026 15:15:39 -0400
Subject: [PATCH] gui: Keep the HUD in a texture between refreshes


diff --git a/src/main/java/net/minecraft/client/gui/Gui.java b/src/main/java/net/minecraft/client/gui/Gui.java
index cb65ff83bcad50093cd0d753bc32b75eff707956..e5a0e85f8ba5f2bc6df10297f8ad20345c551d15 100644
--- a/src/main/java/net/minecraft/client/gui/Gui.java
+++ b/src/main/java/net/minecraft/client/gui/Gui.java
@@ -149,2 +149,5 @@
         this.guiRenderState.reset();
+        // Rinth start: the HUD kept in a texture between refreshes (ADR 0030)
+        rinth.client.gui.HudCache.beginFrame(shouldRenderLevel && this.overlay == null && this.screen == null);
+        // Rinth end
         GuiGraphicsExtractor graphics = new GuiGraphicsExtractor(this.minecraft, this.guiRenderState, xMouse, yMouse);
@@ -189,2 +192,9 @@
 
+        // Rinth start: the HUD kept in a texture between refreshes (ADR 0030)
+        if (rinth.client.gui.HudCache.reusing()) {
+            profiler.pop();
+            graphics.applyCursor(this.minecraft.getWindow());
+            return;
+        }
+        // Rinth end
         if (shouldRenderLevel) {
diff --git a/src/main/java/net/minecraft/client/gui/Hud.java b/src/main/java/net/minecraft/client/gui/Hud.java
index 0669a3f596897b4a2c4fe65eb6d936d1ba8a0081..ee8302717d291313d57ffa22f3cd3b60d8cc1629 100644
--- a/src/main/java/net/minecraft/client/gui/Hud.java
+++ b/src/main/java/net/minecraft/client/gui/Hud.java
@@ -225,2 +225,5 @@
                 graphics.nextStratum();
+                // Rinth start: the HUD kept in a texture between refreshes (ADR 0030)
+                if (rinth.client.gui.HudCache.split(this.minecraft.gameRenderer.gameRenderState().guiRenderState)) return;
+                // Rinth end
                 this.extractHotbarAndDecorations(graphics, deltaTracker);
diff --git a/src/main/java/net/minecraft/client/gui/render/GuiRenderer.java b/src/main/java/net/minecraft/client/gui/render/GuiRenderer.java
index 31771b85e536090eae4ee8adc8b09118bca8e443..deb868eef8ebf195ad1749b36cfa7323ba0326ca 100644
--- a/src/main/java/net/minecraft/client/gui/render/GuiRenderer.java
+++ b/src/main/java/net/minecraft/client/gui/render/GuiRenderer.java
@@ -131,2 +131,5 @@
         this.draw();
+        // Rinth start: the HUD kept in a texture between refreshes (ADR 0030)
+        rinth.client.gui.HudCache.composite();
+        // Rinth end
         profiler.popPush("endFrame");
@@ -198,2 +201,8 @@
 
+            // Rinth start: the HUD above the crosshair goes into its texture, not after a blur (ADR 0030)
+            if (rinth.client.gui.HudCache.divided()) {
+                if (this.draws.size() > this.firstDrawIndexAfterBlur) this.executeDrawRange(() -> "Rinth HUD", rinth.client.gui.HudCache.target(), dynamicTransforms, this.firstDrawIndexAfterBlur, this.draws.size());
+                return;
+            }
+            // Rinth end
             if (this.draws.size() > this.firstDrawIndexAfterBlur) {
