Date: Thu, 1 Oct 2026 08:19:26 -0400
Subject: [PATCH] render: Sort translucent quads with a radix sort


diff --git a/src/main/java/com/mojang/blaze3d/vertex/VertexSorting.java b/src/main/java/com/mojang/blaze3d/vertex/VertexSorting.java
index 2af62659ba56c612455aa9c72c1d98374302542f..d586b59dd0fe74d21f348ff16feeb1c8b147a358 100644
--- a/src/main/java/com/mojang/blaze3d/vertex/VertexSorting.java
+++ b/src/main/java/com/mojang/blaze3d/vertex/VertexSorting.java
@@ -29,3 +29,3 @@
 
-            IntArrays.mergeSort(indices, (o1, o2) -> Floats.compare(keys[o2], keys[o1]));
+            rinth.client.render.QuadSort.sortDescending(keys, indices); // Rinth: the same order by a radix sort (ADR 0027)
             return indices;
