From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rinth-client <335801235+rinth-client@users.noreply.github.com>
Date: Sat, 26 Sep 2026 22:45:52 -0400
Subject: [PATCH] render: Load the Vulkan feature tables only where Vulkan is
 offered


diff --git a/src/main/java/net/minecraft/client/ClientBootstrap.java b/src/main/java/net/minecraft/client/ClientBootstrap.java
index b7ab3b2813b17e836cf19cdf9a22319e002cd7f6..7d6466bbba30723bce3059a0070b52c45f05cd8d 100644
--- a/src/main/java/net/minecraft/client/ClientBootstrap.java
+++ b/src/main/java/net/minecraft/client/ClientBootstrap.java
@@ -30,3 +30,7 @@
             DialogBodyHandlers.bootstrap();
-            VulkanFeatureSets.bootstrap();
+            // Rinth start: only a platform that offers Vulkan has its structs to describe
+            if (rinth.client.platform.GraphicsBackends.isVulkanOffered()) {
+                VulkanFeatureSets.bootstrap();
+            }
+            // Rinth end
         }
