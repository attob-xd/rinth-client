From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rinth-client <335801235+rinth-client@users.noreply.github.com>
Date: Sat, 26 Sep 2026 13:38:50 -0400
Subject: [PATCH] render: Let the entry point switch the frame's render step
 off


diff --git a/src/main/java/net/minecraft/client/Minecraft.java b/src/main/java/net/minecraft/client/Minecraft.java
index 89b8a76dcd9161d5979eb7cc5ea131d8b4e6180c..6626e1fc0c8f6e2504cb56eddf562dce668161e2 100644
--- a/src/main/java/net/minecraft/client/Minecraft.java
+++ b/src/main/java/net/minecraft/client/Minecraft.java
@@ -1307,3 +1307,7 @@
                 profiler.pop();
-                this.gameRenderer.render();
+                // Rinth start: rendering can be switched off (the browser build can boot headless)
+                if (rinth.client.platform.GraphicsBackends.isRendering()) {
+                    this.gameRenderer.render();
+                }
+                // Rinth end
             }
