@@ -269,2 +269,5 @@
         public void resortTransparency() {
+            // Rinth start: a translucent order that holds from every camera is never sorted again
+            if (rinth.client.render.terrain.SectionDraws.keepsOrder(this.getSectionMesh())) return;
+            // Rinth end
             if (this.getSectionMesh() instanceof CompiledSectionMesh mesh) {
