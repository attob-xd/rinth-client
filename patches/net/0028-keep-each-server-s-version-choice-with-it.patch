From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rinth-client <335801235+rinth-client@users.noreply.github.com>
Date: Tue, 29 Sep 2026 07:59:41 -0400
Subject: [PATCH] net: Keep each server's version choice with it


diff --git a/src/main/java/net/minecraft/client/multiplayer/ServerData.java b/src/main/java/net/minecraft/client/multiplayer/ServerData.java
index d7c040d9696f2652ac626b6a7dfcfeee9cbcb260..6da33a6d8ba19bb3fb8bfe56a331d9c47e216643 100644
--- a/src/main/java/net/minecraft/client/multiplayer/ServerData.java
+++ b/src/main/java/net/minecraft/client/multiplayer/ServerData.java
@@ -35,2 +35,5 @@
     private ServerData.State state = ServerData.State.INITIAL;
+    // Rinth start: the version the player chose for this server (Via), saved with it
+    public int rinthVersion = rinth.client.net.ServerVersions.AUTO;
+    // Rinth end
 
@@ -52,2 +55,5 @@
 
+        // Rinth start: the chosen version
+        rinth.client.net.ServerVersions.write(this, tag);
+        // Rinth end
         return tag;
@@ -68,2 +74,5 @@
         server.acceptedCodeOfConduct = tag.getIntOr("acceptedCodeOfConduct", 0);
+        // Rinth start: the chosen version
+        rinth.client.net.ServerVersions.read(server, tag);
+        // Rinth end
         return server;
@@ -113,2 +122,5 @@
         this.type = other.type;
+        // Rinth start: the chosen version
+        this.rinthVersion = other.rinthVersion;
+        // Rinth end
     }
