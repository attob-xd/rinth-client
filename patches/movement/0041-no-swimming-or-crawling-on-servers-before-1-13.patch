Subject: [PATCH] movement: No swimming or crawling on servers before 1.13


diff --git a/src/main/java/net/minecraft/world/entity/Entity.java b/src/main/java/net/minecraft/world/entity/Entity.java
index 54c72acd71b37ae70637833a7ddb6a414d2f8885..2db9aac22dc0e955d661ace4d6466ce2b9bb32fd 100644
--- a/src/main/java/net/minecraft/world/entity/Entity.java
+++ b/src/main/java/net/minecraft/world/entity/Entity.java
@@ -1676,2 +1676,5 @@
     public void updateSwimming() {
+        // Rinth start: no swimming on servers before 1.13
+        if (rinth.client.legacy.LegacyPlayer.noSwimming(this)) return;
+        // Rinth end
         if (this.isSwimming()) {
diff --git a/src/main/java/net/minecraft/world/entity/player/Player.java b/src/main/java/net/minecraft/world/entity/player/Player.java
index b427ddc6ee22625162d14e9fbaa8de52dc79befb..54e8cc0621c38bd3da22ef85b662ba182270b317 100644
--- a/src/main/java/net/minecraft/world/entity/player/Player.java
+++ b/src/main/java/net/minecraft/world/entity/player/Player.java
@@ -345,2 +345,5 @@
     protected void updatePlayerPose() {
+        // Rinth start: no swimming or crawling pose on servers before 1.13
+        if (rinth.client.legacy.LegacyPlayer.updatePose(this)) return;
+        // Rinth end
         if (this.canPlayerFitWithinBlocksAndEntitiesWhen(Pose.SWIMMING)) {
