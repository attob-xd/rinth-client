From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rinth-client <335801235+rinth-client@users.noreply.github.com>
Date: Tue, 29 Sep 2026 18:53:34 -0400
Subject: [PATCH] movement: Stop slow movement as 1.8 does on 1.8 servers


diff --git a/src/main/java/net/minecraft/world/entity/LivingEntity.java b/src/main/java/net/minecraft/world/entity/LivingEntity.java
index ad1cb823151fb7e62f861b02337a64900c35929e..6709c6deca3f3eb2a2ba8fb8033ddae547390002 100644
--- a/src/main/java/net/minecraft/world/entity/LivingEntity.java
+++ b/src/main/java/net/minecraft/world/entity/LivingEntity.java
@@ -3078,2 +3078,5 @@
 
+        // Rinth start: 1.8's cut-off for slow movement, on 1.8 servers
+        if (rinth.client.legacy.LegacyMovement.cutsLikeOld(this)) { Vec3 cut = rinth.client.legacy.LegacyMovement.cut(movement); dx = cut.x; dy = cut.y; dz = cut.z; }
+        // Rinth end
         this.setDeltaMovement(dx, dy, dz);
